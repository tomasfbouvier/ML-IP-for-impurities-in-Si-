units metal
atom_style	atomic
boundary	p p p

read_data  ${input}	

pair_style hybrid/overlay eam/fs tabgap nep
pair_coeff * * eam/fs ../../${X}/${X}-Si.eam.fs Si ${X} 
pair_coeff * * tabgap ../../${X}/${X}-Si.tabgap Si ${X} no yes 
pair_coeff * * nep nep.txt Si NULL 

#min_style fire
#min_style cg
#fix 2 all box/relax aniso 0.0 

timestep 0.001
thermo 100
min_style cg
#min_style  fire	
#fix 1 all recenter INIT INIT INIT
fix 2 all box/relax aniso 0.0 #vmax 0.1

dump myDump all atom 100 dump.lammpstrj

thermo 10
thermo_style custom step pe atoms press
thermo_modify	line one flush yes format 1 "ec %8lu" format float "%20.10g" lost warn

minimize 1.0e-7 1.0e-8 2000 2000

write_data ${output}
run 0
clear

