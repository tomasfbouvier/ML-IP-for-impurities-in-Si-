LAMMPS (30 Mar 2026)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
variable dmax equal 8.25
variable npts equal 100

units           metal
atom_style      atomic
boundary        p p p
atom_modify     map array          # needed to address atom 1 by id in formulas

if "${X} == Si" then     "read_data   dia.data"     "pair_style nep"     "pair_coeff * * nep.txt Si"     "mass 1 28.0855" else     "read_data       Sb_subs.data"     "pair_style hybrid/overlay eam/fs tabgap nep"     "pair_coeff * * eam/fs ../../${X}/${X}-Si.eam.fs Si ${X}"     "pair_coeff * * tabgap ../../${X}/${X}-Si.tabgap Si ${X} no yes"     "pair_coeff * * nep nep.txt Si NULL"
read_data       Sb_subs.data
Reading data file ...
  orthogonal box = (0 0 0) to (10.933026 10.933026 10.933026)
  1 by 1 by 1 MPI processor grid
  reading atom labelmap ...
  reading atoms ...
  64 atoms
  read_data CPU = 0.001 seconds
pair_style hybrid/overlay eam/fs tabgap nep
pair_coeff * * eam/fs ../../${X}/${X}-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Sb/${X}-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Sb/Sb-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Sb/Sb-Si.eam.fs Si Sb
Reading eam/fs potential file ../../Sb/Sb-Si.eam.fs with DATE: 2026-10-23
pair_coeff * * tabgap ../../${X}/${X}-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Sb/${X}-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Sb/Sb-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Sb/Sb-Si.tabgap Si Sb no yes
Reading tabgap potential file ../../Sb/Sb-Si.tabgap with DATE: 2026-10-23
pair_coeff * * nep nep.txt Si NULL
# original position of atom 1 (ASE atom 0), frozen as numbers
variable x0 equal $(x[1])
variable x0 equal 0
variable y0 equal $(y[1])
variable y0 equal 0
variable z0 equal $(z[1])
variable z0 equal 0

# unit direction
#variable ux equal -0.0839203652
#variable uy equal  0.0209800913
#variable uz equal  0.1888208218
variable ux equal -0.666097
variable uy equal 0.333049
variable uz equal -0.999146
variable n  equal sqrt(v_ux^2+v_uy^2+v_uz^2)

thermo_style    custom step pe
thermo_modify   format float %.10g

shell rm -f energy_${X}.dat predict_${X}.dump
shell rm -f energy_Sb.dat predict_${X}.dump
shell rm -f energy_Sb.dat predict_Sb.dump
print "# i d(A) disp(A) E_pot(eV) |F|(eV/A)" file energy_${X}.dat screen no
print "# i d(A) disp(A) E_pot(eV) |F|(eV/A)" file energy_Sb.dat screen no

variable i loop ${npts}
variable i loop 100
label scan

    variable d  equal (v_i-1)*${dmax}/(${npts}-1)
    variable d  equal (v_i-1)*8.25/(${npts}-1)
    variable d  equal (v_i-1)*8.25/(100-1)
    variable px equal v_d*v_ux/v_n
    variable py equal v_d*v_uy/v_n
    variable pz equal v_d*v_uz/v_n

    # place atom 1 at d*direction (absolute, as in the ASE script)
    set atom 1 x ${px} y ${py} z ${pz}
    set atom 1 x 0 y ${py} z ${pz}
    set atom 1 x 0 y 0 z ${pz}
    set atom 1 x 0 y 0 z 0
Setting atom values ...
  1 settings made for x
  1 settings made for y
  1 settings made for z
    run 0

