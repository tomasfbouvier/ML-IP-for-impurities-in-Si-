# ------------------------------------------------------------
# Displace atom 109 on an (dx, dy) grid, compute PE, write to txt
# ------------------------------------------------------------
units           metal
atom_style      atomic            # change if your data file needs another style
boundary        p p p             # adjust to your system

read_data       Sb_vac.data
Reading data file ...
  triclinic box = (-5.5113379 -5.5114274 -5.5112746) to (10.894798 10.894884 10.894736) with tilt (3.0373616e-06 -5.6999617e-06 2.182438e-06)
  2 by 3 by 1 MPI processor grid
  reading atoms ...
  215 atoms
  read_data CPU = 0.003 seconds


pair_style hybrid/overlay eam/fs tabgap nep
pair_coeff * * eam/fs ../../${X}/${X}-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Bi/${X}-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Bi/Bi-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Bi/Bi-Si.eam.fs Si Bi
Reading eam/fs potential file ../../Bi/Bi-Si.eam.fs with DATE: 2026-10-26
pair_coeff * * tabgap ../../${X}/${X}-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Bi/${X}-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Bi/Bi-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Bi/Bi-Si.tabgap Si Bi no yes
Reading tabgap potential file ../../Bi/Bi-Si.tabgap with DATE: 2026-10-26
pair_coeff * * nep nep.txt Si NULL


thermo_modify   norm no           # total energy, not per atom
group           mov id 109
1 atoms in group mov

# ---- scan parameters (Angstrom) ----
variable        dmax   equal 0.8          # scan from -dmax to +dmax
variable        n      equal 35           # points per direction
variable        step   equal 2.0*${dmax}/(${n}-1)
variable        step   equal 2.0*0.8/(${n}-1)
variable        step   equal 2.0*0.8/(35-1)

# ---- output file (header overwrites any old file) ----
variable        outfile string energy_map.txt
print           "# dx(A) dy(A) PE(eV)" file ${outfile} screen no
print           "# dx(A) dy(A) PE(eV)" file energy_map.txt screen no

# ---- reference (undisplaced) energy ----
run             0
WARNING: No fixes with time integration, atoms won't move
For more information see https://docs.lammps.org/err0028 (src/verlet.cpp:60)
Neighbor list info ...
  update: every = 1 steps, delay = 0 steps, check = yes
  max neighbors/atom: 2000, page size: 100000
  master list distance cutoff = 7
  ghost atom cutoff = 7
  binsize = 3.5, bins = 5 5 5
  3 neighbor lists, perpetual/occasional/extra = 3 0 0
  (1) pair eam/fs, perpetual, half/full from (2)
      attributes: half, newton on, cut 7
      pair build: halffull/newton/tri
      stencil: none
      bin: none
  (2) pair tabgap, perpetual
      attributes: full, newton on
      pair build: full/bin/atomonly
      stencil: full/bin/3d
      bin: standard
  (3) pair nep, perpetual, skip from (2)
      attributes: full, newton on
      pair build: skip
      stencil: none
      bin: none
