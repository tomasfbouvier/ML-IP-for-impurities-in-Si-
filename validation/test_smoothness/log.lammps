variable        e0 equal $(pe)
variable        e0 equal -1160.9590611159885611
print           "# E0 = ${e0} eV" append ${outfile} screen no
print           "# E0 = ${e0} eV" append energy_map.txt screen no

# ---- nested scan loop ----
variable        i loop ${n}
variable        i loop 35
label           loop_i
variable        dx equal -${dmax}+(${i}-1)*${step}
variable        dx equal -0.8+(${i}-1)*${step}
variable        dx equal -0.8+(1-1)*${step}
variable        dx equal -0.8+(1-1)*0.0470588235294118

variable        j loop ${n}
variable        j loop 35
label           loop_j
variable        dy equal -${dmax}+(${j}-1)*${step}
variable        dy equal -0.8+(${j}-1)*${step}
variable        dy equal -0.8+(1-1)*${step}
variable        dy equal -0.8+(1-1)*0.0470588235294118

# move atom 109, evaluate energy
displace_atoms  mov move ${dx} ${dy} 0.0 units box
displace_atoms  mov move -0.8 ${dy} 0.0 units box
displace_atoms  mov move -0.8 -0.8 0.0 units box
Displacing atoms ...
