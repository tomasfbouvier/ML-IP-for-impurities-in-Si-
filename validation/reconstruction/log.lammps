timestep 0.001
variable seed equal 11 #uloop 16

pair_style hybrid/overlay eam/fs tabgap nep
pair_coeff * * eam/fs ../../${X}/${X}-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Sb/${X}-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Sb/Sb-Si.eam.fs Si ${X}
pair_coeff * * eam/fs ../../Sb/Sb-Si.eam.fs Si Sb
Reading eam/fs potential file ../../Sb/Sb-Si.eam.fs with DATE: 2026-04-22
pair_coeff * * tabgap ../../${X}/${X}-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Sb/${X}-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Sb/Sb-Si.tabgap Si ${X} no yes
pair_coeff * * tabgap ../../Sb/Sb-Si.tabgap Si Sb no yes
Reading tabgap potential file ../../Sb/Sb-Si.tabgap with DATE: 2026-04-22
pair_coeff * * nep nep.txt Si NULL

region lower_half block $(xlo) $(2*xhi/3-0.1) INF INF INF INF
region lower_half block -0.039868326199999998272 $(2*xhi/3-0.1) INF INF INF INF
region lower_half block -0.039868326199999998272 43.606052188933333014 INF INF INF INF
region upper_half block $(2*xhi/3-0.1) $(xhi) INF INF INF INF
region upper_half block 43.606052188933333014 $(xhi) INF INF INF INF
region upper_half block 43.606052188933333014 65.559078283399998099 INF INF INF INF

group lower region lower_half
2264 atoms in group lower
group upper region upper_half
1192 atoms in group upper

thermo 10

velocity all create 1000.0 $(4883949+v_seed*3) rot yes dist gaussian
velocity all create 1000.0 4883982 rot yes dist gaussian

fix npt_non upper nvt temp 1200 1200 0.1

fix npt_melt lower npt temp 2000.0 1200.0 0.1 iso 0.0 0.0 1.0

dump            myDump all custom 200 dump.lammpstrj.$(part) element id x y z
dump            myDump all custom 200 dump.lammpstrj.0 element id x y z
dump_modify     myDump element Si Sb time yes

run 10000
